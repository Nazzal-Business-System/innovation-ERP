generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  industry     String?
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users                          User[]
  roles                          Role[]
  auditLogs                      AuditLog[]
  branches                       Branch[]
  systemPreferences              SystemPreference[]
  warehouses                     Warehouse[]
  products                       Product[]
  stockBalances                  StockBalance[]
  stockMovements                 StockMovement[]
  stockReservations              StockReservation[]
  stockReservationLines          StockReservationLine[]
  warehouseTransfers             WarehouseTransfer[]
  warehouseTransferLines         WarehouseTransferLine[]
  vendors                        Vendor[]
  purchaseOrders                 PurchaseOrder[]
  purchaseOrderLines             PurchaseOrderLine[]
  customers                      Customer[]
  salesOrders                    SalesOrder[]
  salesOrderLines                SalesOrderLine[]
  accounts                       Account[]
  journalEntries                 JournalEntry[]
  journalEntryLines              JournalEntryLine[]
  departments                    Department[]
  positions                      Position[]
  employees                      Employee[]
  attendanceRecords              AttendanceRecord[]
  leaveRequests                  LeaveRequest[]
  payrollRuns                    PayrollRun[]
  payrollLines                   PayrollLine[]
  employeeContracts              EmployeeContract[]
  employeeDocuments              EmployeeDocument[]
  notifications                  Notification[]
  goodsReceipts                  GoodsReceipt[]
  goodsReceiptLines              GoodsReceiptLine[]
  deliveries                     Delivery[]
  deliveryLines                  DeliveryLine[]
  customerInvoices               CustomerInvoice[]
  customerInvoiceLines           CustomerInvoiceLine[]
  customerPayments               CustomerPayment[]
  vendorBills                    VendorBill[]
  vendorBillLines                VendorBillLine[]
  vendorPayments                 VendorPayment[]
  leads                          Lead[]
  opportunities                  Opportunity[]
  opportunityEvents              OpportunityEvent[]
  crmActivities                  CrmActivity[]
  projects                       Project[]
  projectTasks                   ProjectTask[]
  projectMilestones              ProjectMilestone[]
  supportCategories              SupportCategory[]
  supportTickets                 SupportTicket[]
  supportTicketComments          SupportTicketComment[]
  documentCategories             DocumentCategory[]
  documentFiles                  DocumentFile[]
  documentLinks                  DocumentLink[]
  knowledgeCategories            KnowledgeCategory[]
  knowledgeArticles              KnowledgeArticle[]
  knowledgeArticleTags           KnowledgeArticleTag[]
  knowledgeArticleDocuments      KnowledgeArticleDocument[]
  knowledgeArticleSupportTickets KnowledgeArticleSupportTicket[]

  @@map("organizations")
}

model User {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  email             String
  passwordHash      String    @map("password_hash")
  name              String
  phone             String?
  jobTitle          String?   @map("job_title")
  /**
   * Relative path under API storage root, e.g. avatars/{orgId}/{userId}.jpg — never a public CDN URL.
   */
  avatarPath        String?   @map("avatar_path")
  /**
   * Personal UI preferences (sidebar pins, etc.). Never org-scoped SystemPreference.
   */
  uiPreferences     Json?     @map("ui_preferences")
  /**
   * Optional 1:1 link to an HR Employee record for self-service login.
   */
  employeeId        String?   @unique @map("employee_id")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  /**
   * Last authenticated heartbeat (any tab). Used with lastActiveAt for Online/Away/Offline.
   */
  lastSeenAt        DateTime? @map("last_seen_at")
  /**
   * Last user activity heartbeat (mouse/keyboard/focus). Null when signed out.
   */
  lastActiveAt      DateTime? @map("last_active_at")
  /**
   * Server time of the last presence write (heartbeat / offline).
   */
  presenceUpdatedAt DateTime? @map("presence_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee                  Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  userRoles                 UserRole[]
  auditLogs                 AuditLog[]
  stockMovements            StockMovement[]
  purchaseOrders            PurchaseOrder[]
  salesOrders               SalesOrder[]
  journalEntries            JournalEntry[]
  notifications             Notification[]
  goodsReceiptsReceived     GoodsReceipt[]         @relation("GoodsReceiptReceivedBy")
  deliveriesDelivered       Delivery[]             @relation("DeliveryDeliveredBy")
  customerInvoicesCreated   CustomerInvoice[]      @relation("CustomerInvoiceCreatedBy")
  customerPaymentsCreated   CustomerPayment[]      @relation("CustomerPaymentCreatedBy")
  vendorBillsCreated        VendorBill[]           @relation("VendorBillCreatedBy")
  vendorPaymentsCreated     VendorPayment[]        @relation("VendorPaymentCreatedBy")
  payrollRunsProcessed      PayrollRun[]           @relation("PayrollProcessedBy")
  payrollLinesPaid          PayrollLine[]          @relation("PayrollLinePaidBy")
  leaveRequestsDecided      LeaveRequest[]         @relation("LeaveDecidedBy")
  warehouseTransfersCreated WarehouseTransfer[]
  leadsAssigned             Lead[]                 @relation("LeadAssignedTo")
  opportunitiesAssigned     Opportunity[]          @relation("OpportunityAssignedTo")
  opportunityEventsAuthored OpportunityEvent[]     @relation("OpportunityEventActor")
  crmActivitiesAssigned     CrmActivity[]          @relation("CrmActivityAssignedTo")
  projectsManaged           Project[]              @relation("ProjectManager")
  projectTasksAssigned      ProjectTask[]          @relation("ProjectTaskAssignee")
  supportTicketsAssigned    SupportTicket[]        @relation("SupportTicketAssignedTo")
  supportCommentsAuthored   SupportTicketComment[] @relation("SupportCommentAuthor")
  documentsUploaded         DocumentFile[]         @relation("DocumentUploadedBy")
  knowledgeArticlesAuthored KnowledgeArticle[]     @relation("KnowledgeArticleAuthor")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, lastSeenAt])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(true) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  section     String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([section, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationModule {
  SYSTEM
  INVENTORY
  PROCUREMENT
  SALES
  ACCOUNTING
  HR
  REPORTS
  PROJECTS
  SUPPORT
  DOCUMENTS
  KNOWLEDGE
}

model Notification {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  userId         String?            @map("user_id")
  type           NotificationType
  module         NotificationModule
  title          String
  message        String
  entityType     String?            @map("entity_type")
  entityId       String?            @map("entity_id")
  isRead         Boolean            @default(false) @map("is_read")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, userId, isRead])
  @@index([organizationId, module, createdAt])
  @@map("notifications")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  city           String
  address        String
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model SystemPreference {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          String
  category       String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("system_preferences")
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  DRAFT
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model Warehouse {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  code           String
  name           String
  city           String
  branch         String
  address        String?
  notes          String?
  isActive       Boolean   @default(true) @map("is_active")
  deactivatedAt  DateTime? @map("deactivated_at")
  reactivatedAt  DateTime? @map("reactivated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]     @relation("MovementWarehouse")
  transferMovements    StockMovement[]     @relation("MovementToWarehouse")
  sourceTransfers      WarehouseTransfer[] @relation("TransferSource")
  destinationTransfers WarehouseTransfer[] @relation("TransferDestination")
  stockReservations    StockReservation[]
  purchaseOrders       PurchaseOrder[]
  salesOrders          SalesOrder[]
  goodsReceipts        GoodsReceipt[]
  deliveries           Delivery[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Product {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  sku            String
  name           String
  description    String?
  category       String
  unit           String
  costPrice      Decimal       @map("cost_price") @db.Decimal(12, 2)
  sellPrice      Decimal       @map("sell_price") @db.Decimal(12, 2)
  reorderLevel   Int           @default(0) @map("reorder_level")
  status         ProductStatus @default(ACTIVE)
  isArchived     Boolean       @default(false) @map("is_archived")
  archivedAt     DateTime?     @map("archived_at")
  restoredAt     DateTime?     @map("restored_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  reservationLines     StockReservationLine[]
  transferLines        WarehouseTransferLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  salesOrderLines      SalesOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  deliveryLines        DeliveryLine[]
  customerInvoiceLines CustomerInvoiceLine[]
  vendorBillLines      VendorBillLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, status])
  @@index([organizationId, isArchived])
  @@index([organizationId, name])
  @@map("products")
}

model StockBalance {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  productId        String   @map("product_id")
  warehouseId      String   @map("warehouse_id")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("stock_balances")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockReservation {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  reservationNumber String            @map("reservation_number")
  salesOrderId      String            @map("sales_order_id")
  warehouseId       String            @map("warehouse_id")
  status            ReservationStatus @default(ACTIVE)
  reservedDate      DateTime          @map("reserved_date") @db.Date
  releasedDate      DateTime?         @map("released_date") @db.Date
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines        StockReservationLine[]

  @@unique([organizationId, reservationNumber])
  @@index([organizationId, status])
  @@index([organizationId, salesOrderId])
  @@map("stock_reservations")
}

model StockReservationLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  reservationId  String   @map("reservation_id")
  productId      String   @map("product_id")
  quantity       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId])
  @@index([organizationId, reservationId])
  @@map("stock_reservation_lines")
}

model WarehouseTransfer {
  id                     String         @id @default(uuid())
  organizationId         String         @map("organization_id")
  transferNumber         String         @map("transfer_number")
  sourceWarehouseId      String         @map("source_warehouse_id")
  destinationWarehouseId String         @map("destination_warehouse_id")
  status                 TransferStatus @default(DRAFT)
  transferDate           DateTime       @map("transfer_date") @db.Date
  completedDate          DateTime?      @map("completed_date") @db.Date
  notes                  String?
  createdById            String?        @map("created_by_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse               @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse               @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy            User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines                WarehouseTransferLine[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  transferId     String   @map("transfer_id")
  productId      String   @map("product_id")
  quantity       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transfer     WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([organizationId, transferId])
  @@map("warehouse_transfer_lines")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  productId      String            @map("product_id")
  warehouseId    String            @map("warehouse_id")
  toWarehouseId  String?           @map("to_warehouse_id")
  type           StockMovementType
  quantity       Int
  reference      String?
  notes          String?
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  toWarehouse  Warehouse?   @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Vendor {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  code           String
  name           String
  contactName    String?   @map("contact_name")
  email          String?
  phone          String?
  city           String
  paymentTerms   String    @map("payment_terms")
  notes          String?
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at")
  restoredAt     DateTime? @map("restored_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  vendorPayments VendorPayment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("vendors")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  vendorId       String              @map("vendor_id")
  warehouseId    String              @map("warehouse_id")
  poNumber       String              @map("po_number")
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @map("order_date") @db.Date
  expectedDate   DateTime?           @map("expected_date") @db.Date
  subtotal       Decimal             @db.Decimal(14, 2)
  taxAmount      Decimal             @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(14, 2)
  notes          String?
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  vendorBills   VendorBill[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  quantity        Int
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

enum CustomerType {
  RETAILER
  WHOLESALER
  CORPORATE
  DISTRIBUTOR
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PICKING
  READY_TO_SHIP
  DELIVERED
  INVOICED
  CANCELLED
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  code           String
  name           String
  contactName    String?      @map("contact_name")
  email          String?
  phone          String?
  city           String
  customerType   CustomerType @map("customer_type")
  paymentTerms   String       @map("payment_terms")
  creditLimit    Decimal      @map("credit_limit") @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  archivedAt     DateTime?    @map("archived_at")
  restoredAt     DateTime?    @map("restored_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]
  customerPayments CustomerPayment[]
  convertedLeads   Lead[]
  opportunities    Opportunity[]
  crmActivities    CrmActivity[]
  projects         Project[]
  supportTickets   SupportTicket[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, customerType])
  @@index([organizationId, name])
  @@map("customers")
}

model SalesOrder {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  customerId           String           @map("customer_id")
  warehouseId          String           @map("warehouse_id")
  soNumber             String           @map("so_number")
  status               SalesOrderStatus @default(DRAFT)
  orderDate            DateTime         @map("order_date") @db.Date
  expectedDeliveryDate DateTime?        @map("expected_delivery_date") @db.Date
  subtotal             Decimal          @db.Decimal(14, 2)
  taxAmount            Decimal          @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal          @map("total_amount") @db.Decimal(14, 2)
  notes                String?
  createdById          String?          @map("created_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
