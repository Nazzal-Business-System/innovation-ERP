  taxAmount       Decimal    @map("tax_amount") @db.Decimal(14, 2)
  totalAmount     Decimal    @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal    @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?
  receivedAt      DateTime?  @map("received_at")
  createdById     String?    @map("created_by_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor        Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("VendorBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines         VendorBillLine[]
  payments      VendorPayment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([vendorId])
  @@map("vendor_bills")
}

model VendorBillLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  vendorBillId   String   @map("vendor_bill_id")
  productId      String?  @map("product_id")
  description    String
  quantity       Int
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBill   VendorBill   @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorBillId])
  @@map("vendor_bill_lines")
}

model VendorPayment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  vendorBillId   String        @map("vendor_bill_id")
  vendorId       String        @map("vendor_id")
  paymentNumber  String        @map("payment_number")
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentDate    DateTime      @map("payment_date") @db.Date
  reference      String?
  notes          String?
  createdById    String?       @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBill   VendorBill   @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("VendorPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, paymentDate])
  @@index([vendorBillId])
  @@index([vendorId])
  @@map("vendor_payments")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  FIELD_SALES
  EVENT
  OTHER
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  FOLLOW_UP
}

model Lead {
  id                  String     @id @default(uuid())
  organizationId      String     @map("organization_id")
  leadNumber          String     @map("lead_number")
  companyName         String     @map("company_name")
  contactName         String     @map("contact_name")
  email               String?
  phone               String?
  city                String
  source              LeadSource
  status              LeadStatus @default(NEW)
  estimatedValue      Decimal    @map("estimated_value") @db.Decimal(14, 2)
  assignedToId        String?    @map("assigned_to_id")
  convertedCustomerId String?    @map("converted_customer_id")
  notes               String?
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo        User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomer Customer?     @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  activities        CrmActivity[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@map("leads")
}

model Opportunity {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  opportunityNumber String           @map("opportunity_number")
  leadId            String?          @map("lead_id")
  customerId        String?          @map("customer_id")
  title             String
  stage             OpportunityStage @default(PROSPECTING)
  estimatedValue    Decimal          @map("estimated_value") @db.Decimal(14, 2)
  probability       Int              @default(10)
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  assignedToId      String?          @map("assigned_to_id")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  events       OpportunityEvent[]

  @@unique([organizationId, opportunityNumber])
  @@index([organizationId, stage])
  @@map("opportunities")
}

enum OpportunityEventType {
  CREATED
  STAGE_CHANGED
  OWNER_CHANGED
  VALUE_UPDATED
  PROBABILITY_UPDATED
  CLOSE_DATE_UPDATED
  TITLE_UPDATED
  NOTES_UPDATED
  ACTIVITY_LINKED
}

model OpportunityEvent {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  opportunityId  String               @map("opportunity_id")
  type           OpportunityEventType
  summary        String
  details        String?
  actorId        String?              @map("actor_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OpportunityEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, opportunityId, createdAt])
  @@map("opportunity_events")
}

model CrmActivity {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  leadId         String?         @map("lead_id")
  opportunityId  String?         @map("opportunity_id")
  customerId     String?         @map("customer_id")
  type           CrmActivityType
  subject        String
  dueDate        DateTime?       @map("due_date") @db.Date
  completedAt    DateTime?       @map("completed_at")
  assignedToId   String?         @map("assigned_to_id")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("CrmActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@index([organizationId, completedAt])
  @@map("crm_activities")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMilestoneStatus {
  PENDING
  COMPLETED
  MISSED
}

model Project {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  code           String
  name           String
  customerId     String?       @map("customer_id")
  managerId      String?       @map("manager_id")
  startDate      DateTime?     @map("start_date") @db.Date
  targetDate     DateTime?     @map("target_date") @db.Date
  status         ProjectStatus @default(PLANNING)
  progress       Int           @default(0)
  budget         Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  manager        User?              @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  tasks          ProjectTask[]
  milestones     ProjectMilestone[]
  supportTickets SupportTicket[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectTask {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  projectId      String              @map("project_id")
  title          String
  assigneeId     String?             @map("assignee_id")
  priority       ProjectTaskPriority @default(MEDIUM)
  dueDate        DateTime?           @map("due_date") @db.Date
  status         ProjectTaskStatus   @default(TODO)
  description    String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@map("project_tasks")
}

model ProjectMilestone {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  projectId      String                 @map("project_id")
  title          String
  dueDate        DateTime?              @map("due_date") @db.Date
  status         ProjectMilestoneStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@map("project_milestones")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketSource {
  EMAIL
  PHONE
  /**
   * @deprecated External portals removed; retained for historical Support ticket rows only.
   */
  PORTAL
  INTERNAL
  WHATSAPP
  OTHER
}

model SupportCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      SupportTicket[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("support_categories")
}

model SupportTicket {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  ticketNumber   String         @map("ticket_number")
  customerId     String?        @map("customer_id")
  projectId      String?        @map("project_id")
  categoryId     String?        @map("category_id")
  title          String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  source         TicketSource   @default(INTERNAL)
  assignedToId   String?        @map("assigned_to_id")
  openedAt       DateTime       @default(now()) @map("opened_at")
  dueAt          DateTime?      @map("due_at")
  resolvedAt     DateTime?      @map("resolved_at")
  closedAt       DateTime?      @map("closed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?                       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project        Project?                        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category       SupportCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo     User?                           @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments       SupportTicketComment[]
  knowledgeLinks KnowledgeArticleSupportTicket[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, dueAt])
  @@map("support_tickets")
}

model SupportTicketComment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ticketId       String   @map("ticket_id")
  authorId       String?  @map("author_id")
  body           String
  isInternal     Boolean  @default(false) @map("is_internal")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?         @relation("SupportCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId])
  @@map("support_ticket_comments")
}

enum ErpDocumentStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
  PENDING_REVIEW
}

enum DocumentModule {
  HR
  FINANCE
  PROCUREMENT
  SALES
  SUPPORT
  PROJECTS
  CRM
  OPERATIONS
  ACCOUNTING
  SYSTEM
}

model DocumentCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  files        DocumentFile[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("document_categories")
}

model DocumentFile {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  categoryId     String?           @map("category_id")
  fileNumber     String            @map("file_number")
  title          String
  description    String?
  fileName       String            @map("file_name")
  fileUrl        String            @map("file_url")
  mimeType       String            @map("mime_type")
  fileSize       Int               @map("file_size")
  status         ErpDocumentStatus @default(ACTIVE)
  expiryDate     DateTime?         @map("expiry_date")
  uploadedById   String?           @map("uploaded_by_id")
  uploadedAt     DateTime          @default(now()) @map("uploaded_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       DocumentCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy     User?                      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  links          DocumentLink[]
  knowledgeLinks KnowledgeArticleDocument[]

  @@unique([organizationId, fileNumber])
  @@index([organizationId, status])
  @@index([organizationId, expiryDate])
  @@map("document_files")
}

model DocumentLink {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  documentFileId String         @map("document_file_id")
  module         DocumentModule
  entityType     String         @map("entity_type")
  entityId       String         @map("entity_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentFile DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  @@index([organizationId, module, entityType, entityId])
  @@index([organizationId, documentFileId])
  @@map("document_links")
}

enum KnowledgeArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeVisibility {
  INTERNAL
  PUBLIC
  SUPPORT_ONLY
}

model KnowledgeCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     KnowledgeArticle[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  categoryId     String?                @map("category_id")
  articleNumber  String                 @map("article_number")
  title          String
  summary        String?
  content        String
  status         KnowledgeArticleStatus @default(DRAFT)
  visibility     KnowledgeVisibility    @default(INTERNAL)
  authorId       String?                @map("author_id")
  publishedAt    DateTime?              @map("published_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       KnowledgeCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         User?                           @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags           KnowledgeArticleTag[]
  documents      KnowledgeArticleDocument[]
  supportTickets KnowledgeArticleSupportTicket[]

  @@unique([organizationId, articleNumber])
  @@index([organizationId, status])
  @@index([organizationId, visibility])
  @@index([organizationId, categoryId])
  @@map("knowledge_articles")
}

model KnowledgeArticleTag {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  articleId      String   @map("article_id")
  tag            String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, articleId, tag])
  @@index([organizationId, tag])
  @@map("knowledge_article_tags")
}

model KnowledgeArticleDocument {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  articleId      String   @map("article_id")
  documentFileId String   @map("document_file_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  documentFile DocumentFile     @relation(fields: [documentFileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, articleId, documentFileId])
  @@index([organizationId, documentFileId])
  @@map("knowledge_article_documents")
}

model KnowledgeArticleSupportTicket {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  articleId       String   @map("article_id")
  supportTicketId String   @map("support_ticket_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket    @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  @@unique([organizationId, articleId, supportTicketId])
  @@index([organizationId, supportTicketId])
  @@map("knowledge_article_support_tickets")
}
