model LeaveRequest {
  id                 String      @id @default(uuid())
  organizationId     String      @map("organization_id")
  employeeId         String      @map("employee_id")
  type               LeaveType
  startDate          DateTime    @map("start_date") @db.Date
  endDate            DateTime    @map("end_date") @db.Date
  days               Decimal     @db.Decimal(4, 1)
  status             LeaveStatus @default(PENDING)
  reason             String?
  /**
   * Employee responsible for reviewing a pending request.
   */
  assignedApproverId String?     @map("assigned_approver_id")
  /**
   * Legacy employee decision actor (seed / older records).
   * New approvals set decidedById (User) instead; keep this for historical display fallback.
   */
  approvedById       String?     @map("approved_by_id")
  /**
   * Authenticated user who approved or rejected the request.
   */
  decidedById        String?     @map("decided_by_id")
  decidedAt          DateTime?   @map("decided_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedApprover Employee?    @relation("LeaveAssignedApprover", fields: [assignedApproverId], references: [id], onDelete: SetNull)
  approvedBy       Employee?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decidedBy        User?        @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@index([organizationId, startDate])
  @@index([organizationId, assignedApproverId])
  @@index([organizationId, decidedById])
  @@map("leave_requests")
}

